# Discord bot token (create at https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here

# Optional: guild ID for instant slash command sync (recommended for a single server)
# GUILD_ID=123456789012345678

# Optional: database path (default in Docker is /app/data/bard.db)
# DATABASE_PATH=/app/data/bard.db

# Optional: role ID for "generic DM" — given to anyone who is DM of at least one game (e.g. for a shared DM resource category)
# DM_RESOURCE_ROLE_ID=1473088103899205827

# Media player web UI (runs in same process as bot). Set WEB_PORT=0 to disable.
# WEB_PORT=5000
# Bind to 0.0.0.0 for LAN access; use 127.0.0.1 for localhost only.
# WEB_HOST=0.0.0.0

# --- Web player login -------------------------------------------------------
# Required unless WEB_AUTH=off. Anyone with this password gets the full player.
WEB_PASSWORD=change_me
# Username to sign in with (default: bard)
# WEB_USERNAME=bard
# Signs session cookies. Without it a random key is generated at startup, which
# signs every browser out on restart. Generate one: openssl rand -hex 32
# WEB_SECRET_KEY=
# Set to "off" ONLY for a trusted LAN — it serves the UI with no login at all.
# WEB_AUTH=on
# on | off | auto (default). auto marks the cookie Secure when the request
# arrives over HTTPS, so plain-HTTP LAN access keeps working.
# WEB_COOKIE_SECURE=auto
